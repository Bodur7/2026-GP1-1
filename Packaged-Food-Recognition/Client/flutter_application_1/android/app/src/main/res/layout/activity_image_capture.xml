<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Top White Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:background="#FFFFFF">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_back_button"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <!-- Logo Image Container with exact same dimensions as Flutter AppHeader -->
        <FrameLayout
            android:layout_width="95dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/iv_brand_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Misbar Logo" />

            <TextView
                android:id="@+id/tv_brand_logo_fallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="مسبار\nMisbar"
                android:textColor="#385842"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="end|center_vertical"
                android:visibility="gone" />
        </FrameLayout>

    </RelativeLayout>

    <!-- Main Scanner Dark Green View -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1E3526">

        <!-- Title -->
        <TextView
            android:id="@+id/tv_scan_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="Scan Packed Label"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Viewfinder Center Container -->
        <LinearLayout
            android:id="@+id/layout_viewfinder_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/viewfinder_box"
                android:layout_width="260dp"
                android:layout_height="200dp">

                <!-- Corners Frame -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/viewfinder_corners"
                    android:scaleType="fitXY" />

                <!-- Center Price Tag -->
                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_tag" />

                <!-- Scanning Laser Line -->
                <View
                    android:id="@+id/view_laser_line"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/laser_line_glow" />

            </RelativeLayout>

            <!-- Helper Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="40dp"
                android:text="Waiting for the label — position it in the frame, then tap Capture"
                android:textAlignment="center"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Bottom Controls Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="36dp"
            android:paddingHorizontal="30dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 1. Flash Toggle -->
            <LinearLayout
                android:id="@+id/btn_flash"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_flash_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:src="@drawable/ic_flash"
                    android:padding="13dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Flash"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 2. Large Shutter Capture Button -->
            <LinearLayout
                android:id="@+id/btn_capture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/bg_shutter_outer">

                    <ImageView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/bg_shutter_inner"
                        android:src="@drawable/ic_camera"
                        android:padding="15dp" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Capture"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Upload Image from Gallery -->
            <LinearLayout
                android:id="@+id/btn_upload_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_circle_translucent"
                    android:src="@drawable/ic_gallery"
                    android:padding="13dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Upload Image"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</LinearLayout>
